            "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger Server"
          ],
          "gameProjectRelativePath": "addons\\data\\ArmaReforger.gproj",
          "processNamePrefix": "ArmaReforgerServer",
          "argTemplate": [
            "-server",
            "{WORLDPATH}",
            "-MissionHeader",
            "{MISSIONHEADER}",
            "-addonsDir",
            "{ADDONSDIR}",
            "-addons",
            "{ADDONLIST}",
            "-profile",
            "{PROFILE}",
            "-maxFPS",
            "30",
            "-nothrow",
            "-logLevel",
            "normal",
            "-bgoneMpBot",
            "-bgoneMpScenario",
            "{SCENARIO}"
          ],
          "readyPattern": "NETWORK\\s+:\\s*Starting RPL server, listening on",
          "readyTimeoutSec": 240,
          "selfExits": false
        },
        "client": {
          "exeCandidates": [
            "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger\\ArmaReforgerSteam.exe",
            "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger\\ArmaReforgerSteam.exe"
          ],
          "gameDirCandidates": [
            "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger",
            "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger"
          ],
          "gameProjectRelativePath": "addons\\data\\ArmaReforger.gproj",
          "processNamePrefix": "ArmaReforgerSteam",
          "argTemplate": [
            "-addonsDir",
            "{ADDONSDIR}",
            "-addons",
            "{ADDONLIST}",
            "-client",
            "-connect",
            "127.0.0.1",
            "-port",
            "2001",
            "-rpl-reconnect",
            "-rpl-timeout-disable",
            "-profile",
            "{PROFILE}",
            "-window",
            "-forceupdate",
            "-nofocus",
            "-noThrow",
            "-maxFPS",
            "30",
            "-bgoneMpBot",
            "-bgoneMpScenario",
            "{SCENARIO}",
            "-bgoneMpClient",
            "{CLIENTINDEX}"
          ],
          "connectedPattern": "RPL\\s+:\\s*Client event Connected",
          "selfExits": false
        },
        "patterns": {
          "BotArmed": "BGONE_MPBOT \\| ARMED",
          "BotConnected": "BGONE_MPBOT \\| CONNECTED \\| localPlayerId=(?<id>\\d+) onClient=(?<onclient>\\d)",
          "BotServerAck": "BGONE_MPBOT \\| SERVER_ACK \\| (?<scenario>[a-zA-Z0-9_-]+) \\| (?<result>PASS|FAIL) \\|",
          "BotVerdict": "BGONE_MPBOT \\| VERDICT \\| (?<result>PASS|FAIL) \\| (?<scenario>[a-zA-Z0-9_-]+) \\| (?<detail>.*)$"
        }
      }
    },
