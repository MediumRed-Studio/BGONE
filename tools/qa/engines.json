{
  "schemaVersion": 2,
  "_readme": [
    "Configuration for BGONE headless QA runners (tools/qa/qa-run.ps1 and tools/qa/mp-run.ps1).",
    "Single-addon layout: addon.gproj lives at the worktree root (ID 'BGONE', GUID '5F1EE615E7AE3106').",
    "External staging junction C:\\wt\\.bgone-stage\\<sha1-8>\\Addons\\BGONE -> <worktree> supplies -addonsDir",
    "so sibling worktrees under C:\\wt are never scanned and no symlink is created inside the checkout.",
    "Both stable and exp tracks target Reforger 1.9.0.37 (retail server + retail client pair for MP)."
  ],
  "defaults": {
    "targetEngine": "stable",
    "module": "BGONE",
    "addonId": "BGONE",
    "addonGuid": "5F1EE615E7AE3106",
    "vanillaAddonGuid": "58D0FB3206B6F859",
    "gate": "workbench",
    "timeoutSec": 1200,
    "quietSec": 60,
    "settledQuietSec": 10,
    "graceSec": 10,
    "pollSec": 2,
    "pidResolveSec": 20,
    "keepRuns": 20,
    "queueTimeoutSec": 14400,
    "addonResolutionEnforce": "fail",
    "logFileName": "console.log",
    "errorLogFileName": "error.log",
    "reportFileNames": [
      "junit.xml",
      "autotest.xml",
      "report.xml"
    ],
    "reportExcludePatterns": [
      "*settings*.xml",
      "*Settings*.xml",
      "*.rpt.xml",
      "*profile*.xml"
    ],
    "fallbackLogRoots": [
      "%USERPROFILE%\\Documents\\My Games\\ArmaReforgerWorkbench\\logs"
    ],
    "concurrency": "concurrent",
    "worktreeSafety": {
      "requireSpaceFreePath": true,
      "forbiddenRootSubstrings": [
        "Documents\\My Games\\ArmaReforgerWorkbench\\addons"
      ]
    },
    "rdbChurnGlob": "resourceDatabase.rdb",
    "memory": {
      "lowFreeWarnMb": 6144,
      "launchNeedMb": 5120,
      "launchWaitSec": 120,
      "settleTimeoutSec": 120,
      "settlePollSec": 5,
      "settleToleranceMb": 256,
      "settleStableSamples": 3,
      "struggleFreeMb": 700,
      "struggleCpuPct": 97,
      "struggleFps": 8,
      "sampleSec": 5
    }
  },
  "engines": {
    "stable": {
      "label": "stable",
      "validatedVersion": "1.9.0.37",
      "exeCandidates": [
        "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger Tools\\Workbench\\ArmaReforgerWorkbenchSteamDiag.exe",
        "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger Tools\\Workbench\\ArmaReforgerWorkbenchSteamDiag.exe"
      ],
      "gameDirCandidates": [
        "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger",
        "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger"
      ],
      "gameProjectRelativePath": "addons\\data\\ArmaReforger.gproj",
      "processNamePrefix": "ArmaReforgerWorkbench",
      "wbModule": "ResourceManager",
      "argTemplate": [
        "-gproj",
        "{GPROJ}",
        "-addonsDir",
        "{ADDONSDIR}",
        "-wbModule={WBMODULE}",
        "-profile",
        "{PROFILE}"
      ],
      "extraArgs": [],
      "rewritesResourceDatabase": true,
      "server": {
        "label": "stable-server",
        "exeCandidates": [
          "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger Server\\ArmaReforgerServer.exe",
          "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger Server\\ArmaReforgerServer.exe"
        ],
        "gameDirCandidates": [
          "Z:\\SteamLibrary\\steamapps\\common\\Arma Reforger Server",
          "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Arma Reforger Server"
        ],
        "gameProjectRelativePath": "addons\\data\\ArmaReforger.gproj",
        "processNamePrefix": "ArmaReforgerServer",
        "argTemplate": [
          "-addonsDir",
          "{ADDONSDIR}",
          "-addons",
          "{ADDONLIST}",
          "-listScenarios",
          "-profile",
          "{PROFILE}"
        ],
        "extraArgs": [
          "-nothrow"
        ],
        "rewritesResourceDatabase": false
      },
      "mp": {
        "label": "stable-mp",
        "excludeAddons": [],
        "worldPath": "Worlds/MPTest/MPTest.ent",
        "missionHeaderPath": "Missions/BGONE_MPTest.conf",
        "botCliFlag": "-bgoneMpBot",
        "botScenarioCliFlag": "-bgoneMpScenario",
        "loadTimeoutSec": 360,
        "scenarioTimeoutSec": 180,
        "gameplayScenarioTimeoutSec": 240,
        "lateJoin": {},
        "sessionTouches": {},
        "teardownErrors": {
